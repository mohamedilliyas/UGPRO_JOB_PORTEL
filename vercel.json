{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron.php",
      "schedule": "*/10 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/style.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.2"
    },
    {
      "src": "api/cron.php",
      "use": "vercel-php@0.7.2"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "bootstrap-5.3.3-dist/**",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    },
    {
      "src": "uploads/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/cron",
      "dest": "/api/cron.php"
    },
    {
      "src": "/cron.php",
      "dest": "/api/cron.php"
    },
    {
      "src": "/api/cron",
      "dest": "/api/cron.php"
    },
    {
      "src": "/api/cron.php",
      "dest": "/api/cron.php"
    },
    {
      "src": "/style.css(.*)",
      "dest": "/style.css"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
