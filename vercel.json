{
  "version": 2,
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "admin/*.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "jobs/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
